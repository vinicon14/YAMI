{
  "name": "yami",
  "version": "0.1.0",
  "private": true,
  "description": "YAMI — assistente pessoal de IA com agentes, múltiplos provedores, voz contínua e controle do computador.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @yami/desktop smoke",
    "dev": "pnpm --filter @yami/desktop dev",
    "start": "pnpm --filter @yami/desktop start",
    "package": "pnpm --filter @yami/desktop package"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}